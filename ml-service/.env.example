# ---------------------------------------------------------------------------
# ML service configuration
# Copy to `.env` and adjust. Every value has a working default in src/config.py.
# ---------------------------------------------------------------------------

# --- service ---------------------------------------------------------------
APP_NAME=loan-risk-ml-service
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# --- storage paths ---------------------------------------------------------
# Absolute paths inside the container, or relative to ml-service/ when local.
DATA_DIR=./data
RAW_DATA_DIR=./data/raw
PROCESSED_DATA_DIR=./data/processed
REGISTRY_DIR=./models
LOG_DIR=./logs

# Source CSV used for training.
RAW_DATASET_PATH=../Loan_default - Loan_default (1).csv

# --- training --------------------------------------------------------------
RANDOM_SEED=42
TEST_SIZE=0.15
VAL_SIZE=0.15
CV_FOLDS=5
# class_weight | smote | undersample | smote_tomek | none
IMBALANCE_STRATEGY=class_weight
TUNING_ITERATIONS=25

# --- risk banding ----------------------------------------------------------
# Must match the backend's AUTO_APPROVE_THRESHOLD / AUTO_REJECT_THRESHOLD.
LOW_RISK_CUTOFF=25
HIGH_RISK_CUTOFF=75

# --- fraud -----------------------------------------------------------------
# Combined rule probability at or above which an application is flagged.
FRAUD_SCORE_THRESHOLD=0.55

# --- fairness --------------------------------------------------------------
# Four-fifths rule: alert when the disparate impact ratio drops below this.
DISPARATE_IMPACT_FLOOR=0.80
DEMOGRAPHIC_PARITY_TOLERANCE=0.10

# --- monitoring ------------------------------------------------------------
DRIFT_PSI_WARN=0.10
DRIFT_PSI_ALERT=0.25
MIN_ACCEPTABLE_AUC=0.68

# --- retraining ------------------------------------------------------------
# Minimum AUC gain a challenger must show before it replaces the champion.
PROMOTION_MIN_AUC_GAIN=0.002
